<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF121212">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#FF1E1E2E">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NexusVM Engine"
            android:textSize="24sp"
            android:textColor="#FF00E5FF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: Uninitialized"
            android:textSize="14sp"
            android:textColor="#FFAAAAAA"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvRomPath"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ROM: Not loaded"
            android:textSize="12sp"
            android:textColor="#FF888888"
            android:layout_marginTop="2dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:indeterminate="true"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Control Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center">

        <Button
            android:id="@+id/btnLoadRom"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="Load ROM"
            android:textSize="12sp"
            android:backgroundTint="#FF2196F3" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="Start"
            android:textSize="12sp"
            android:enabled="false"
            android:backgroundTint="#FF4CAF50" />

        <Button
            android:id="@+id/btnPause"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="Pause"
            android:textSize="12sp"
            android:enabled="false"
            android:backgroundTint="#FFFFC107" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="Stop"
            android:textSize="12sp"
            android:enabled="false"
            android:backgroundTint="#FFF44336" />
    </LinearLayout>

    <!-- Guest Display Surface -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FF000000">

        <SurfaceView
            android:id="@+id/surfaceView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Overlay: Boot message -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Guest Display\n(Load ROM and Start to begin)"
            android:textColor="#FF555555"
            android:textSize="16sp"
            android:gravity="center" />
    </FrameLayout>

</LinearLayout>
